    ex:comune          "Sulmona" ;
    ex:lunghezzaKm     60.0 ;
    ex:dislivelloM     2200 ;
    ex:difficolta      "E" ;
    ex:rischioSovraffollamento  "basso" ;
    ex:capacitaMassima          150 ;
    ex:accessibilitaDisabili    "assente" ;
    ex:sensibilitaAmbientale    "alta" ;
    ex:areaProtetta             true ;
    ex:passesThrough            ex:GranSasso .

ex:AnelloCampoImperatore  a ex:HikingTrail ;
    ex:nome            "Anello di Campo Imperatore"@it ;
    ex:descrizione     "Trekking ad anello sull'altopiano più grande d'Italia, il 'Piccolo Tibet'."@it ;
    ex:provincia       "L'Aquila" ;
    ex:comune          "Castel del Monte" ;
    ex:lunghezzaKm     18.0 ;
    ex:dislivelloM     600 ;
    ex:difficolta      "E" ;
    ex:rischioSovraffollamento  "alto" ;
