ex:CattedraleSanBerardo  a ex:HistoricalSite ;
    ex:nome            "Cattedrale di San Berardo – Teramo"@it ;
    ex:descrizione     "Duomo romanico-gotico del XII secolo nel centro storico di Teramo."@it ;
    ex:provincia       "Teramo" ;
