    ex:accessibilitaDisabili    "assente" ;
    ex:sensibilitaAmbientale    "protetta" ;
    ex:areaProtetta             true ;
    ex:passesThrough            ex:GranSasso .

ex:CiclabileTrabocchi  a ex:HikingTrail ;
    ex:nome            "Via Verde della Costa dei Trabocchi"@it ;
    ex:descrizione     "Pista ciclabile e pedonale lungo la costa adriatica su un vecchio tracciato ferroviario."@it ;
    ex:provincia       "Chieti" ;
