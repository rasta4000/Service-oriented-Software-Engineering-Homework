ex:AlbergoDiffusoSextantio  a ex:LocalProducer ;
    ex:nome                "Sextantio – Albergo Diffuso"@it ;
    ex:descrizione         "Struttura ricettiva diffusa nel borgo di Santo Stefano di Sessanio, recupero architettonico."@it ;
    ex:provincia           "L'Aquila" ;
