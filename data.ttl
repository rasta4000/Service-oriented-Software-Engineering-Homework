    geo:lat            "42.6589"^^xsd:decimal ;
    geo:long           "13.7045"^^xsd:decimal ;
    ex:annoFondazione  "1158"^^xsd:gYear ;
    ex:rischioSovraffollamento  "basso" ;
    ex:capacitaMassima          400 ;
    ex:accessibilitaDisabili    "completa" ;
    ex:sensibilitaAmbientale    "bassa" ;
    ex:areaProtetta             false ;
    ex:visitatoriMediGiornalieri 150 .

# ==============================================================================
# ISTANZE – Percorsi Escursionistici
# ==============================================================================

ex:SentieroDelloSpirito  a ex:HikingTrail ;
    ex:nome            "Sentiero dello Spirito – Maiella"@it ;
    ex:descrizione     "Spettacolare sentiero panoramico scavato nella roccia sulla Maiella orientale."@it ;
    ex:provincia       "Chieti" ;
    ex:comune          "Fara San Martino" ;
    ex:lunghezzaKm     12.5 ;
    ex:dislivelloM     850 ;
    ex:difficolta      "EE" ;
    ex:rischioSovraffollamento  "medio" ;
    ex:capacitaMassima          200 ;
    ex:accessibilitaDisabili    "assente" ;
    ex:sensibilitaAmbientale    "protetta" ;
    ex:areaProtetta             true ;
    ex:passesThrough            ex:GranSasso .

ex:SentieroDellaLiberta  a ex:HikingTrail ;
    ex:nome            "Sentiero della Libertà"@it ;
    ex:descrizione     "Percorso storico della Seconda Guerra Mondiale dal versante aquilano a Casoli."@it ;
