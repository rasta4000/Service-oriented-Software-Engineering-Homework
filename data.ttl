@prefix ex:    <http://example.org/tourism#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:   <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# ==============================================================================
# ONTOLOGIA – Classi
# ==============================================================================

ex:PointOfInterest  a owl:Class ;
    rdfs:label "Punto di interesse turistico"@it .

ex:NaturalSite  a owl:Class ;
    rdfs:subClassOf ex:PointOfInterest ;
    rdfs:label "Sito naturale"@it .

ex:HistoricalSite  a owl:Class ;
    rdfs:subClassOf ex:PointOfInterest ;
    rdfs:label "Sito storico-culturale"@it .

ex:HikingTrail  a owl:Class ;
    rdfs:label "Percorso escursionistico"@it .

ex:LocalEvent  a owl:Class ;
    rdfs:label "Evento locale"@it .

ex:LocalProducer  a owl:Class ;
    rdfs:label "Produttore / operatore commerciale locale"@it .

# ==============================================================================
# ONTOLOGIA – Proprietà (Object Properties)
# ==============================================================================

ex:locatedIn  a owl:ObjectProperty ;
    rdfs:label "situato in provincia di"@it ;
    rdfs:domain ex:PointOfInterest ;
    rdfs:range  xsd:string .

ex:passesThrough  a owl:ObjectProperty ;
    rdfs:label "attraversa il punto di interesse"@it ;
    rdfs:domain ex:HikingTrail ;
    rdfs:range  ex:PointOfInterest .

ex:producerNear  a owl:ObjectProperty ;
    rdfs:label "produttore vicino al punto di interesse"@it ;
    rdfs:domain ex:LocalProducer ;
    rdfs:range  ex:PointOfInterest .

ex:eventLocation  a owl:ObjectProperty ;
    rdfs:label "luogo dell'evento"@it ;
    rdfs:domain ex:LocalEvent ;
    rdfs:range  ex:PointOfInterest .

# ==============================================================================
# ONTOLOGIA – Proprietà (Datatype Properties)
# ==============================================================================

ex:nome  a owl:DatatypeProperty ;
    rdfs:label "nome"@it ;
    rdfs:range xsd:string .

ex:descrizione  a owl:DatatypeProperty ;
    rdfs:label "descrizione"@it ;
    rdfs:range xsd:string .

ex:provincia  a owl:DatatypeProperty ;
    rdfs:label "provincia"@it ;
    rdfs:range xsd:string .

ex:comune  a owl:DatatypeProperty ;
    rdfs:label "comune"@it ;
    rdfs:range xsd:string .

# --- Proprietà rilevanti per EaaS ---

ex:rischioSovraffollamento  a owl:DatatypeProperty ;
    rdfs:label "livello di rischio sovraffollamento (overtourism)"@it ;
    rdfs:comment "Valori: basso, medio, alto, critico"@it ;
    rdfs:range xsd:string .

ex:capacitaMassima  a owl:DatatypeProperty ;
    rdfs:label "capacità massima giornaliera di visitatori"@it ;
    rdfs:range xsd:integer .

ex:accessibilitaDisabili  a owl:DatatypeProperty ;
    rdfs:label "livello di accessibilità per utenti con disabilità"@it ;
    rdfs:comment "Valori: completa, parziale, assente"@it ;
    rdfs:range xsd:string .

ex:sensibilitaAmbientale  a owl:DatatypeProperty ;
    rdfs:label "sensibilità ambientale del sito"@it ;
    rdfs:comment "Valori: bassa, media, alta, protetta"@it ;
    rdfs:range xsd:string .

ex:areaProtetta  a owl:DatatypeProperty ;
    rdfs:label "il sito è dentro un'area protetta"@it ;
    rdfs:range xsd:boolean .

ex:dimensioneOperatore  a owl:DatatypeProperty ;
    rdfs:label "dimensione dell'operatore commerciale"@it ;
    rdfs:comment "Valori: micro, piccolo, medio, grande"@it ;
    rdfs:range xsd:string .

ex:categoriaCommerciale  a owl:DatatypeProperty ;
    rdfs:label "categoria commerciale del produttore"@it ;
    rdfs:range xsd:string .

ex:difficolta  a owl:DatatypeProperty ;
    rdfs:label "difficoltà del percorso"@it ;
    rdfs:comment "Scala CAI: T, E, EE, EEA"@it ;
    rdfs:range xsd:string .

ex:lunghezzaKm  a owl:DatatypeProperty ;
    rdfs:label "lunghezza in km"@it ;
    rdfs:range xsd:decimal .

ex:dislivelloM  a owl:DatatypeProperty ;
    rdfs:label "dislivello in metri"@it ;
    rdfs:range xsd:integer .

ex:dataInizio  a owl:DatatypeProperty ;
    rdfs:label "data inizio evento"@it ;
    rdfs:range xsd:date .

ex:dataFine  a owl:DatatypeProperty ;
    rdfs:label "data fine evento"@it ;
    rdfs:range xsd:date .

ex:annoFondazione  a owl:DatatypeProperty ;
    rdfs:label "anno di fondazione o costruzione"@it ;
    rdfs:range xsd:gYear .

ex:visitatoriMediGiornalieri  a owl:DatatypeProperty ;
    rdfs:label "numero medio di visitatori giornalieri"@it ;
    rdfs:range xsd:integer .

# ==============================================================================
# ISTANZE – Siti Naturali
# ==============================================================================

ex:GranSasso  a ex:NaturalSite ;
    ex:nome            "Parco Nazionale del Gran Sasso e Monti della Laga"@it ;
    ex:descrizione     "Il più grande parco d'Abruzzo, con il Corno Grande (2912 m), ghiacciai e valli spettacolari."@it ;
    ex:provincia       "L'Aquila" ;
    ex:comune          "Assergi" ;
    geo:lat            "42.4692"^^xsd:decimal ;
    geo:long           "13.5656"^^xsd:decimal ;
    ex:rischioSovraffollamento  "alto" ;
    ex:capacitaMassima          3000 ;
    ex:accessibilitaDisabili    "parziale" ;
    ex:sensibilitaAmbientale    "protetta" ;
    ex:areaProtetta             true ;
    ex:visitatoriMediGiornalieri 2800 .

ex:LagoScanno  a ex:NaturalSite ;
    ex:nome            "Lago di Scanno"@it ;
    ex:descrizione     "Lago naturale a forma di cuore, circondato da montagne, ideale per passeggiate e canoa."@it ;
    ex:provincia       "L'Aquila" ;
    ex:comune          "Scanno" ;
    geo:lat            "41.9260"^^xsd:decimal ;
    geo:long           "13.8730"^^xsd:decimal ;
    ex:rischioSovraffollamento  "medio" ;
    ex:capacitaMassima          1500 ;
    ex:accessibilitaDisabili    "parziale" ;
    ex:sensibilitaAmbientale    "alta" ;
    ex:areaProtetta             false ;
    ex:visitatoriMediGiornalieri 900 .

ex:CostaDeiTrabocchi  a ex:NaturalSite ;
    ex:nome            "Costa dei Trabocchi"@it ;
    ex:descrizione     "Tratto di costa adriatica con antiche macchine da pesca su palafitta, pista ciclabile e spiagge."@it ;
    ex:provincia       "Chieti" ;
    ex:comune          "San Vito Chietino" ;
    geo:lat            "42.3016"^^xsd:decimal ;
    geo:long           "14.4521"^^xsd:decimal ;
    ex:rischioSovraffollamento  "alto" ;
    ex:capacitaMassima          5000 ;
    ex:accessibilitaDisabili    "completa" ;
    ex:sensibilitaAmbientale    "media" ;
    ex:areaProtetta             false ;
    ex:visitatoriMediGiornalieri 4200 .

ex:RiservaDaniele  a ex:NaturalSite ;
    ex:nome            "Riserva Naturale Regionale Lecceta di Torino di Sangro"@it ;
    ex:descrizione     "Riserva costiera con boschi di leccio, dune e zona umida retrodunale."@it ;
    ex:provincia       "Chieti" ;
    ex:comune          "Torino di Sangro" ;
    geo:lat            "42.2154"^^xsd:decimal ;
    geo:long           "14.5282"^^xsd:decimal ;
    ex:rischioSovraffollamento  "basso" ;
    ex:capacitaMassima          400 ;
    ex:accessibilitaDisabili    "assente" ;
    ex:sensibilitaAmbientale    "protetta" ;
    ex:areaProtetta             true ;
    ex:visitatoriMediGiornalieri 120 .

# ==============================================================================
